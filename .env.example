# Copy to .env and fill in real values - see docs/google-sign-in.md for
# where GOOGLE_WEB_CLIENT_ID comes from (Google Cloud Console's "Web
# application" OAuth client, not the Android one).

# The Web application OAuth client ID from Google Cloud Console - used as
# the `audience` when verifying a Google ID token, so it must match the
# webClientId the frontend passes to GoogleSignin.configure().
GOOGLE_WEB_CLIENT_ID=

# Any long random string, used to sign this app's own session tokens
# (issued after a Google sign-in verifies successfully). Generate one with
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
JWT_SECRET=
