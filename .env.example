# Copy to .env and fill in real values - see docs/google-sign-in.md for
# where GOOGLE_WEB_CLIENT_ID comes from (Google Cloud Console's "Web
# application" OAuth client, not the Android one).

# The Web application OAuth client ID from Google Cloud Console - used as
# the `audience` when verifying a Google ID token, so it must match the
# webClientId the frontend passes to GoogleSignin.configure().
GOOGLE_WEB_CLIENT_ID=

# Any long random string, used to sign this app's own session tokens
# (issued after a Google sign-in verifies successfully). Generate one with
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
JWT_SECRET=

# --- optional -------------------------------------------------------------

# Port to listen on. Most hosts inject this themselves; defaults to 3000.
PORT=3000

# SQLite database file path. Defaults to articles.db in the working dir.
# On a container host, point this at a mounted volume so data survives a
# redeploy.
DB_PATH=articles.db

# Comma-separated list of allowed CORS origins (e.g.
# https://app.example.com,https://admin.example.com). Leave unset to
# reflect any origin - fine for the native app, which isn't subject to
# CORS; set it once a browser origin exists.
CORS_ORIGIN=

# Set to "true" to allow GET /stories/top?debug=true to return the ranking
# score breakdown. Off unless explicitly enabled - never set this in
# production.
ENABLE_RANKING_DEBUG=

# pino log level (trace|debug|info|warn|error|fatal|silent). Defaults to
# info (silent under NODE_ENV=test). Output is pretty-printed in local dev,
# JSON in production.
LOG_LEVEL=
