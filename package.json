{
  "name": "news-khabri-backend",
  "version": "1.0.0",
  "description": "Backend for News Khabri: pulls Indian-publisher RSS feeds, clusters same-event coverage into stories, ranks them, and serves a small REST API.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "revoke-sessions": "node src/scripts/revoke-all-sessions.js"
  },
  "keywords": [
    "news",
    "rss",
    "clustering",
    "express",
    "sqlite"
  ],
  "author": "Chetan Shetty",
  "license": "ISC",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "expo-server-sdk": "^7.2.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.3.0",
    "jose": "^5.10.0",
    "jsdom": "^30.0.1",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "rss-parser": "^3.13.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "jest": "^30.4.2",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2"
  }
